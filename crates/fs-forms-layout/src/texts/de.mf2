# Die Fehlertexte der Layout-Schnittstelle (Präfix layout-error-), Deutsch (ADR 0057: MessageFormat 2). Jede Kennung hat ihr englisches Gegenstück in en.mf2.
layout-error-store-broken = Der Speicher von Forms ist beschädigt ({$cause}); er wurde nicht verändert: {$file}
layout-error-store-newer = Der Speicher {$file} ist neuer ({$found}) als dieses Programm ({$known}).
layout-error-store-busy = Der Speicher {$file} ist belegt.
layout-error-read-only = Der Speicher ist nur lesbar ({$which}).
layout-error-unreachable = Der Dienst antwortet nicht: {$socket}
layout-error-unsupported = Das wird hier noch nicht unterstützt: {$what}
layout-error-unknown = Nicht gefunden: {$what} {$id}
layout-error-rev-changed = {$id} wurde inzwischen geändert (erwartet {$expected}, gefunden {$found}).
layout-error-page-size = Die Seitengröße {$size} ist zu groß oder null (höchstens {$max}).
layout-error-cursor-invalid = Die Seitenmarke gilt nicht mehr.
layout-error-package-owned = {$id} gehört einem Paket und lässt sich nur über ein Overlay ändern.
layout-error-exists = Es gibt schon ein Frontend {$frontend} für {$extends}.
layout-error-not-overlayable = Auf {$id} lässt sich kein Overlay legen; eigene Beschreibungen ändert man direkt.
layout-error-locked = {$elem} ist gesperrt ({$reason}, von {$by}).
layout-error-reason-missing = Zum {$what} gehört ein Grund.
layout-error-import-invalid = {$file}, Zeile {$line}: Die Datei ist nicht lesbar ({$cause}).
layout-error-format-newer = Das Dateiformat {$found} ist neuer als das bekannte {$known}.
layout-error-format-invalid = Das Dateiformat {$found} gibt es nicht.
layout-error-elem-invalid = Zeile {$line}: Die Kennung {$elem} ist ungültig.
layout-error-elem-missing = Zeile {$line}: Hier fehlt die Kennung (elem).
layout-error-elem-twice = Die Kennung {$elem} kommt zweimal vor ({$kind}).
layout-error-elem-unknown = Es gibt kein Element {$elem} ({$kind}).
layout-error-key-twice = Doppelter Schlüssel {$key} ({$kind}).
layout-error-range-invalid = Der Versionsbereich {$text} ist ungültig; er braucht untere und obere Grenze.
layout-error-block-unknown = {$elem}: Den Baustein {$block} gibt es nicht.
layout-error-binding-invalid = {$elem}: Die Bindung ist ungültig ({$cause}).
layout-error-key-invalid = Der Textschlüssel {$key} ist ungültig.
layout-error-lang-invalid = Die Sprache {$lang} ist ungültig.
layout-error-message-invalid = Der Text {$key} ({$lang}) ist ungültig: {$cause}
layout-error-too-many = Zu viel: {$what} (Grenze {$max}, gesetzt durch {$by}).
layout-error-text-too-long = {$elem}: Der Text hat {$bytes} Bytes, erlaubt sind {$max} (gesetzt durch {$by}).
layout-error-schemes-missing = {$elem}: Für das Feld {$path} fehlt die Liste der erlaubten Schemata.
layout-error-schemes-empty = {$elem}: Die Liste der erlaubten Schemata ist leer.
layout-error-scheme-never = {$elem}: Das Schema {$scheme} ist nie erlaubt.
layout-error-scheme-bad = {$elem}: {$scheme} ist kein gültiger Schemaname (klein geschrieben, RFC 3986).
layout-error-scheme-twice = {$elem}: Das Schema {$scheme} steht zweimal in der Liste.
layout-error-schemes-unexpected = {$elem}: Für das Feld {$path} gibt es keine Schemata, die Liste ist zu viel.
layout-error-provider-unchecked = Der Anbieter {$capability} konnte nicht gefragt werden; die Prüfung steht noch aus.
layout-error-overlay-conflict = Das Overlay {$overlay} passt an Stelle {$seq} nicht mehr ({$cause}).
layout-error-op-invalid = Das Overlay {$overlay}, Stelle {$seq}: Die Änderung ist ungültig ({$cause}).
layout-error-orphaned = Das Overlay {$overlay} ist verwaist; sein Paket ist nicht mehr installiert.
layout-error-export-failed = Der Export nach {$file} ging nicht ({$kind}).
layout-error-content-too-large = {$name} hat {$bytes} Bytes, erlaubt sind {$max} (gesetzt durch {$by}).
layout-error-menu-invalid = {$elem}: Der Menüeintrag ist ungültig ({$cause}).
layout-error-source-unknown = {$elem}: Die Quelle {$source} gibt es in dieser Beschreibung nicht.
layout-error-place-unknown = {$elem}: Der Rahmen {$frame} hat keinen Platz {$place}.
layout-error-place-takes = {$elem}: Der Platz {$place} nimmt {$name} nicht auf.
layout-error-place-count = {$elem}: Der Platz {$place} hat {$count} Kinder, erlaubt sind {$min} bis {$max}.
layout-error-set-unknown = {$elem}: {$owner} kennt die Einstellung {$name} nicht; sie wird übergangen.
layout-error-format-old = Das Dateiformat {$found} ist zu alt; bekannt ist das Format {$known}. Die Seiten bitte neu als Plätze schreiben ([[page.place]], siehe Beschreibung von Format 3); alte Dateien werden nicht umgewandelt.
