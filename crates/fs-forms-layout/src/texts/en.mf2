# The error texts of the layouts interface (prefix layout-error-), English (ADR 0057: MessageFormat 2). Every key has its German counterpart in de.mf2.
layout-error-store-broken = The Forms store is damaged ({$cause}); it was not changed: {$file}
layout-error-store-newer = The store {$file} is newer ({$found}) than this program ({$known}).
layout-error-store-busy = The store {$file} is busy.
layout-error-read-only = The store is read-only ({$which}).
layout-error-unreachable = The service does not answer: {$socket}
layout-error-unsupported = This is not supported here yet: {$what}
layout-error-unknown = Not found: {$what} {$id}
layout-error-rev-changed = {$id} was changed meanwhile (expected {$expected}, found {$found}).
layout-error-page-size = The page size {$size} is zero or too large (at most {$max}).
layout-error-cursor-invalid = The page cursor is no longer valid.
layout-error-package-owned = {$id} belongs to a package and can only be changed through an overlay.
layout-error-exists = There is already a frontend {$frontend} for {$extends}.
layout-error-not-overlayable = No overlay can be put on {$id}; change your own descriptions directly.
layout-error-locked = {$elem} is locked ({$reason}, by {$by}).
layout-error-reason-missing = A reason is required for {$what}.
layout-error-import-invalid = {$file}, line {$line}: the file cannot be read ({$cause}).
layout-error-format-newer = The file format {$found} is newer than the known {$known}.
layout-error-format-invalid = The file format {$found} does not exist.
layout-error-elem-invalid = Line {$line}: the element id {$elem} is invalid.
layout-error-elem-missing = Line {$line}: the element id (elem) is missing here.
layout-error-elem-twice = The element id {$elem} occurs twice ({$kind}).
layout-error-elem-unknown = There is no element {$elem} ({$kind}).
layout-error-key-twice = Duplicate key {$key} ({$kind}).
layout-error-range-invalid = The version range {$text} is invalid; it needs a lower and an upper bound.
layout-error-block-unknown = {$elem}: there is no block {$block}.
layout-error-binding-invalid = {$elem}: the binding is invalid ({$cause}).
layout-error-key-invalid = The text key {$key} is invalid.
layout-error-lang-invalid = The language {$lang} is invalid.
layout-error-message-invalid = The text {$key} ({$lang}) is invalid: {$cause}
layout-error-too-many = Too many: {$what} (limit {$max}, set by {$by}).
layout-error-text-too-long = {$elem}: the text has {$bytes} bytes, {$max} are allowed (set by {$by}).
layout-error-schemes-missing = {$elem}: the list of allowed schemes is missing for the field {$path}.
layout-error-schemes-empty = {$elem}: the list of allowed schemes is empty.
layout-error-scheme-never = {$elem}: the scheme {$scheme} is never allowed.
layout-error-scheme-bad = {$elem}: {$scheme} is not a valid scheme name (lower case, RFC 3986).
layout-error-scheme-twice = {$elem}: the scheme {$scheme} is in the list twice.
layout-error-schemes-unexpected = {$elem}: the field {$path} has no schemes, the list is not wanted.
layout-error-provider-unchecked = The provider {$capability} could not be asked; the check is still pending.
layout-error-overlay-conflict = The overlay {$overlay} no longer fits at position {$seq} ({$cause}).
layout-error-op-invalid = The overlay {$overlay}, position {$seq}: the change is invalid ({$cause}).
layout-error-orphaned = The overlay {$overlay} is orphaned; its package is no longer installed.
layout-error-export-failed = The export to {$file} failed ({$kind}).
layout-error-content-too-large = {$name} has {$bytes} bytes, {$max} are allowed (set by {$by}).
layout-error-menu-invalid = {$elem}: the menu entry is invalid ({$cause}).
layout-error-source-unknown = {$elem}: there is no source {$source} in this description.
layout-error-place-unknown = {$elem}: the frame {$frame} has no place {$place}.
layout-error-place-takes = {$elem}: the place {$place} does not take {$name}.
layout-error-place-count = {$elem}: the place {$place} has {$count} children, {$min} to {$max} are allowed.
layout-error-set-unknown = {$elem}: {$owner} has no setting {$name}; it is ignored.
layout-error-format-old = The file format {$found} is too old; the known format is {$known}. Write the pages again as places ([[page.place]], see the format 3 description); old files are not converted.
