# Die Worte des Forms-Hosts, Deutsch (ADR 0057: MessageFormat 2). Jede Id braucht ihr englisches Gegenstück in en.mf2.
host-title = Formulare
host-error-no-socket = Kein Socket des Forms-Servers bekannt; der Starter muss einen nennen
host-error-layouts-unreachable = Der Forms-Server antwortet nicht
host-error-layouts-contract-missing = Der Forms-Server bietet die Layouts nicht an, die dieser Host spricht
host-error-layout-missing = Dieses Programm hat kein Layout für dieses Frontend
host-error-layout-store = Der Layout-Speicher ist im Notbetrieb
host-error-frontend-unknown = Keine Beschreibung trägt dieses Frontend
host-error-frontend-ambiguous = Mehrere Beschreibungen tragen dieses Frontend
host-error-block-unknown = Dieser Teil kann nicht gezeichnet werden: diesen Baustein gibt es im Vertrag der Komponenten nicht
host-error-block-not-built = Dieser Teil kann noch nicht gezeichnet werden: sein Baustein ist in dieser Version nicht gebaut
host-error-no-pages = Das Layout hat keine Seiten
host-status-ready = Bereit
host-status-partial = Einige Teile sind gesperrt; der Rest läuft
host-status-locked = Gesperrt
host-status-rest = der Rest läuft
host-status-window = das Fenster
host-status-refused = Nichts kann gezeichnet werden
host-status-sample = Beispieldaten (nicht Ihre Einträge)
host-page-empty = Diese Seite ist leer
host-menu-coming = kommt noch
host-screen-error = Problem
host-error-layout-unreadable = Die Beschreibung dieses Frontends ist nicht lesbar oder besteht die Prüfung nicht
host-notice-no-providers = Datenquellen sind in dieser Version nicht angeschlossen; die Teile zeigen ihren Rahmen, keine Daten
host-notice-data-unreachable = Die Datenquelle dieses Fensters antwortet nicht; die Tafel zeigt keine Einträge
host-notice-data-no-socket = Für die Datenquelle ist kein Socket bekannt (kein Laufzeitordner); die Tafel zeigt keine Einträge
host-notice-data-contract = Die Datenquelle dieses Fensters hat nicht die Version, die die Beschreibung verlangt; das Fenster zeigt keine Einträge
host-notice-data-answer = Die Datenquelle hat etwas geantwortet, das dieses Fenster nicht annimmt; es zeigt keine Einträge
host-notice-data-reload = Das Modul hat die Änderung angenommen, aber das erneute Lesen ist fehlgeschlagen; die Tafel zeigt den alten Stand bis zum nächsten Lesen
host-notice-source-unknown = Keine Datenquelle dieses Hosts spricht den Vertrag, den die Beschreibung nennt; die Tafel zeigt keine Einträge
host-notice-style-unknown = Die Beschreibung nennt einen Stil, den es in dieser Version nicht gibt; es gilt der für das Programm eingestellte Stil
channel-label = Person
channel-role = Rolle
channel-level = Stufe
form-unknown = Das Modul bietet eine Form an, die der Formkatalog nicht kennt
form-version-mismatch = Modul und Block zeichnen verschiedene Versionen der Form
form-write-missing = Die Geste hat einen Wert nicht geliefert, den die Form braucht; es wurde nichts gesendet
form-write-unmapped = Das Modul bindet kein Feld an einen Kanal, den die Geste schreibt; es wurde nichts gesendet
action-channel-mismatch = Die Aktion ruft einen anderen Befehl als den, den das Modul an ihre Geste gebunden hat
form-channel-unmapped = Das Modul lässt einen Pflichtkanal der Form unbelegt
form-basic-mismatch = Ein Feld des Moduls passt nicht zur Art des Kanals
form-no-component = Kein Block zeichnet diese Form; der Rückfall wird gezeigt
host-notice-frame-not-built = Dieser Rahmen kann noch nicht gezeichnet werden; was darin steht, zeigt diese Version nicht
host-notice-raised = Dieser Datensatz ist schon offen; sein Fenster wurde nach vorn geholt
host-notice-open-unanswered = An diesem Platz ist schon ein anderer Datensatz offen und niemand hat gesagt, was geschehen soll; es wurde nichts geöffnet
host-notice-frontend-unknown = Kein Frontend dieses Namens ist bekannt; die Fläche bleibt, wie sie ist (id, available)
host-notice-frontend-other-program = Dieses Frontend gehört zu einem anderen Programm; die Fläche bleibt, wie sie ist (id, frontend)
host-notice-frontend-open-elsewhere = Dieses Frontend zeigt diesen Datensatz schon an einem anderen Platz; die Fläche bleibt, wie sie ist (id, other)
host-notice-window-id-taken = Ein Platz dieses Namens ist offen und zeigt etwas anderes; es wurde nichts geöffnet (id)
host-notice-placement-unsupported = Dieses Frontend kann nur ein Panel in einem offenen Fenster seines Eltern-Frontends sein; es wurde nicht geändert
host-notice-frontend-not-opened = Das hier platzierte Frontend ist in diesem Fenster nicht geöffnet
host-notice-record-other-range = Dieser Datensatz gehört zu einem anderen Programm; das Fenster wurde nicht geändert
host-open-ask = An diesem Platz ist schon ein anderer Datensatz offen
host-open-ask-switch = Hier zeigen
host-open-ask-window = Neues Fenster öffnen
host-notice-frontend-missing = Für dieses Frontend gibt es keine Beschreibung; es wurde nichts geöffnet
host-notice-frontend-refused = Das Modul hat die Verbindung nicht angenommen; es wurde nichts geöffnet
host-notice-frontend-list-failed = Die Frontends dieses Programms konnten nicht gelesen werden; die Fläche bleibt, wie sie ist (extends, cause)
host-notice-more-pages = Weitere Seiten dieses Frontends sind in diesem Fenster noch nicht erreichbar (pages)
host-notice-placement-locked = Das Programm erlaubt nicht, diesen Platz zu ändern
host-notice-window-unknown = Dieses Fenster ist nicht offen
host-notice-open-ask-failed = Die Frage konnte nicht gezeigt werden; es wurde nichts geöffnet
host-notice-window-failed = Das Fenster konnte nicht geöffnet werden
host-menu-view = Ansicht
host-notice-scope-from-not-built = Der Datensatz dieses Panels kommt aus der Auswahl eines anderen Teils; das ist noch nicht gebaut, darum wird das Panel nicht gezeigt (frontend)
host-notice-frontend-on-open-not-built = Dieses Frontend öffnet sich über die Aktion open – noch nicht gebaut, darum wird es nicht gezeigt (frontend)
host-notice-frontend-loop = Dieses Frontend würde sich selbst enthalten, direkt oder über andere Frontends; es wird nicht gezeigt (frontend)
host-notice-window-not-opened-by-menu = Ein Fenster, das dieses Frontend verlangt, wurde nicht geöffnet: das Menü kann noch keine Fenster öffnen (frontend)
