# Die Worte des Forms-Hosts, Deutsch (ADR 0057: MessageFormat 2). Jede Id braucht ihr englisches Gegenstück in en.mf2.
host-title = Formulare
host-error-no-socket = Kein Socket des Forms-Servers bekannt; der Starter muss einen nennen
host-error-layouts-unreachable = Der Forms-Server antwortet nicht
host-error-layouts-contract-missing = Der Forms-Server bietet die Layouts nicht an, die dieser Host spricht
host-error-layout-missing = Dieses Programm hat kein Layout für dieses Frontend
host-error-layout-store = Der Layout-Speicher ist im Notbetrieb
host-error-block-not-built = Dieser Teil kann noch nicht gezeichnet werden: sein Baustein ist in dieser Version nicht gebaut
host-error-no-pages = Das Layout hat keine Seiten
host-status-ready = Bereit
host-status-partial = Einige Teile sind gesperrt; der Rest läuft
host-status-refused = Nichts kann gezeichnet werden
host-page-empty = Diese Seite ist leer
host-menu-coming = kommt noch
host-screen-error = Problem
host-error-layout-unreadable = Die Beschreibung dieses Frontends ist nicht lesbar oder besteht die Prüfung nicht
host-notice-no-providers = Datenquellen sind in dieser Version nicht angeschlossen; die Teile zeigen ihren Rahmen, keine Daten
kanban-add_column = Spalte hinzufügen
kanban-rename = Umbenennen
kanban-limit = Grenze setzen
kanban-drop = Hier ablegen
kanban-grab = Aufnehmen
kanban-move_left = Nach links
kanban-move_right = Nach rechts
kanban-more_facts = weitere
kanban-empty = Hier ist nichts
kanban-soon = Kommt später
