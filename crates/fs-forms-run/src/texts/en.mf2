# The words of the forms host, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
host-title = Forms
host-error-no-socket = No socket of the forms server is known; the starter must name one
host-error-layouts-unreachable = The forms server does not answer
host-error-layouts-contract-missing = The forms server does not offer the layouts this host speaks
host-error-layout-missing = This program has no layout for this frontend
host-error-layout-store = The store of layouts is in emergency mode
host-error-frontend-unknown = No description carries this frontend
host-error-frontend-ambiguous = Several descriptions carry this frontend
host-error-block-unknown = This part cannot be drawn: no such block is in the contract of the components
host-error-block-not-built = This part cannot be drawn yet: its block is not built in this version
host-error-no-pages = The layout has no pages
host-status-ready = Ready
host-status-partial = Some parts are locked; the rest works
host-status-locked = Locked
host-status-rest = the rest works
host-status-window = the window
host-status-refused = Nothing can be drawn
host-status-sample = Sample data (not your records)
host-page-empty = This page is empty
host-menu-coming = coming soon
host-screen-error = Problem
host-error-layout-unreadable = The description of this frontend cannot be read or does not pass the checks
host-notice-style-unknown = The description names a style this version does not have; the style set for the program is used
host-notice-no-providers = Data sources are not connected in this version; the parts show their frame, not their data
host-notice-data-unreachable = The data source of this window does not answer; the board shows no records
host-notice-data-no-socket = No socket is known for the data source (no runtime folder); the board shows no records
host-notice-data-contract = The data source of this window is not the version the description asks for; the window shows no records
host-notice-data-answer = The data source answered something this window does not accept; it shows no records
host-notice-data-reload = The module took the change, but reading it again failed; the board shows the old state until the next reading
host-notice-source-unknown = No data source of this host speaks the contract the description names; the board shows no records
channel-label = Person
channel-role = Role
channel-level = Level
form-unknown = The module offers a form the form catalog does not have
form-version-mismatch = The module and the block draw different versions of the form
form-write-missing = The gesture did not deliver a value the form needs; nothing was sent
form-write-unmapped = The module binds no field to a channel the gesture writes; nothing was sent
action-channel-mismatch = The module binds the command of the action to no channel of the form; the control stays locked
action-arg-unknown = A value the gesture carries is no channel of the form
action-arg-from-record = The gesture does not carry a value the command must have; it is taken from the record
form-channel-unmapped = The module leaves a required channel of the form unmapped
form-basic-mismatch = A field of the module does not fit the kind of the channel
form-no-component = No block draws this form; the fallback is shown
host-notice-frame-not-built = This frame cannot be drawn yet; what is inside it is not shown in this version
host-notice-raised = This record is already open; its window was brought to the front
host-notice-open-unanswered = This place already shows another record and nobody has said what to do; nothing was opened
host-notice-frontend-unknown = No frontend of this name is known; the surface stays as it is (id, available)
host-notice-frontend-other-program = This frontend belongs to another program; the surface stays as it is (id, frontend)
host-notice-frontend-open-elsewhere = This frontend already shows this record in another place; the surface stays as it is (id, other)
host-notice-window-id-taken = A place of this name is open and shows something else; nothing was opened (id)
host-notice-placement-unsupported = This frontend can only be a panel inside an open window of its parent; it was not changed
host-notice-frontend-not-opened = The frontend placed here is not opened in this window
host-notice-record-other-range = This record belongs to another program; the window was not changed
host-open-ask = This place already shows another record
host-open-ask-switch = Show it here
host-open-ask-window = Open a new window
host-notice-frontend-missing = There is no description of this frontend; nothing was opened
host-notice-frontend-refused = The module did not accept the connection; nothing was opened
host-notice-frontend-list-failed = The frontends of this program could not be read; the surface stays as it is (extends, cause)
host-notice-more-pages = More pages of this frontend cannot be reached in this window yet (pages)
host-notice-placement-locked = The program does not allow this place to be changed
host-notice-window-unknown = This window is not open
host-notice-open-ask-failed = The question could not be shown; nothing was opened
host-notice-window-failed = The window could not be opened
host-menu-view = View
host-notice-scope-from-not-built = The record of this panel comes from the selection of another part; that is not built yet, so the panel is not shown (frontend)
host-notice-frontend-on-open-not-built = This frontend opens through the action open; that is not built yet, so it is not shown (frontend)
host-notice-frontend-loop = This frontend would contain itself, directly or through other frontends; it is not shown (frontend)
host-notice-window-not-opened-by-menu = A window this frontend asks for was not opened: the menu cannot open windows yet (frontend)
host-menu-edit = Edit
host-notice-undo-nothing = Nothing to undo
host-notice-redo-nothing = Nothing to redo
host-notice-undo-done = Undone
host-notice-redo-done = Redone
host-notice-undo-refused = Undo refused
host-notice-redo-refused = Redo refused
host-notice-lanes-missing = The list of lanes is missing; the board shows its columns without lanes
host-notice-lanes-form-undeclared = The block {$block} names no form for its lane list; the board shows its columns without lanes
host-notice-lanes-source-absent = The source of the lane list is not there (source {$source}); the board shows its columns without lanes
form-source-unknown-scope = The module does not know the scope of the lane list; the board shows its columns without lanes
bind-error-heads-form-missing = The module declares no entry of the right form and type for the lane list; the board shows its columns without lanes
accepts-error-contract-missing = The module that gives the lane list is not installed; the board shows its columns without lanes
