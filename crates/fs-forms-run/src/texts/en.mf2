# The words of the forms host, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
host-title = Forms
host-error-no-socket = No socket of the forms server is known; the starter must name one
host-error-layouts-unreachable = The forms server does not answer
host-error-layouts-contract-missing = The forms server does not offer the layouts this host speaks
host-error-layout-missing = This program has no layout for this frontend
host-error-layout-store = The store of layouts is in emergency mode
host-error-block-unknown = This part cannot be drawn: no such block is in the contract of the components
host-error-block-not-built = This part cannot be drawn yet: its block is not built in this version
host-error-no-pages = The layout has no pages
host-status-ready = Ready
host-status-partial = Some parts are locked; the rest works
host-status-refused = Nothing can be drawn
host-status-sample = Sample data (not your records)
host-page-empty = This page is empty
host-menu-coming = coming soon
host-screen-error = Problem
host-error-layout-unreadable = The description of this frontend cannot be read or does not pass the checks
host-notice-style-unknown = The description names a style this version does not have; the style set for the program is used
host-notice-no-providers = Data sources are not connected in this version; the parts show their frame, not their data
host-notice-data-unreachable = The data source of this window does not answer; the board shows no records
host-notice-data-no-socket = No socket is known for the data source (no runtime folder); the board shows no records
host-notice-data-contract = The data source of this window is not the version the description asks for; the window shows no records
host-notice-data-answer = The data source answered something this window does not accept; it shows no records
host-notice-data-reload = The module took the change, but reading it again failed; the board shows the old state until the next reading
host-notice-source-unknown = No data source of this host speaks the contract the description names; the board shows no records
kanban-refused-locked = Locked: the description does not allow this
kanban-refused-unsupported = The data source cannot do this
kanban-refused-unreachable = The data source does not answer
kanban-refused-conflict = The board changed meanwhile; please try again
kanban-refused-rejected = The data source refused this
kanban-refused-no-board = There is no board
kanban-refused-failed = That did not work
kanban-add_column = Add a column
kanban-rename = Rename
kanban-limit = Set the limit
kanban-drop = Drop here
kanban-grab = Pick up
kanban-move_left = Move left
kanban-move_right = Move right
kanban-more_facts = more
kanban-empty = Nothing here
kanban-soon = Comes later
kanban-add_card = Add a card
kanban-add_card_hint = Title of a new card
kanban-add_card_ok = Add
kanban-new_column = New column
kanban-column_name = Name of the column
kanban-limit_placeholder = Number of cards
kanban-limit_hint = The most cards the column should hold; 0 = no limit
kanban-limit_invalid = That is not a whole number; type 0 for no limit
channel-label = Person
channel-role = Role
channel-level = Level
form-unknown = The module offers a form the form catalog does not have
form-version-mismatch = The module and the block draw different versions of the form
form-write-missing = The gesture did not deliver a value the form needs; nothing was sent
form-write-unmapped = The module binds no field to a channel the gesture writes; nothing was sent
action-channel-mismatch = The action calls another command than the module bound to its gesture
form-channel-unmapped = The module leaves a required channel of the form unmapped
form-basic-mismatch = A field of the module does not fit the kind of the channel
form-no-component = No block draws this form; the fallback is shown
host-notice-frame-not-built = This frame cannot be drawn yet; what is inside it is not shown in this version
